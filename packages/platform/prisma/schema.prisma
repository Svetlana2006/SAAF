generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Citizen ──────────────────────────────────────────────────────────────────
model Citizen {
  citizenId   String   @id @default(cuid()) @map("citizen_id")
  supabaseUserId String? @unique @map("supabase_user_id")
  clerkUserId String? @unique @map("clerk_user_id")
  name        String
  email       String   @unique
  phone       String?
  role        String   // citizen/volunteer/RWA
  location    String?
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")

  reports               Report[]
  citizenConfirmations  CitizenConfirmation[]

  @@map("citizens")
}

// ── Report ───────────────────────────────────────────────────────────────────
model Report {
  reportId    String   @id @default(cuid()) @map("report_id")
  citizenId   String?  @map("citizen_id")
  locationId  String?  @map("location_id")
  category    String
  description String
  photoUrl    String?  @map("photo_url")
  severity    String
  status      String   // open/assigned/completed
  isAnonymous Boolean  @default(true) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")

  citizen  Citizen?  @relation(fields: [citizenId], references: [citizenId])
  location Location? @relation(fields: [locationId], references: [locationId])

  citizenConfirmations CitizenConfirmation[]
  ngoOffers           NgoReportOffer[]
  missions            Mission[]
  images              ReportImage[]

  @@map("reports")
}

model ReportImage {
  imageId       String   @id @default(cuid()) @map("image_id")
  reportId      String   @map("report_id")
  photoUrl      String   @map("photo_url")
  cloudinaryId  String?  @map("cloudinary_id")
  purpose       String   @default("report")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  report Report @relation(fields: [reportId], references: [reportId], onDelete: Cascade)

  @@index([reportId, uploadedAt])
  @@map("report_images")
}

// ── Location ─────────────────────────────────────────────────────────────────
model Location {
  locationId String   @id @default(cuid()) @map("location_id")
  nameArea   String   @map("name_area")
  address    String
  latitude   Float
  longitude  Float
  wardZone   String   @map("ward_zone")
  areaType   String   @map("area_type") // slum/residential/corporate
  isHotspot  Boolean  @default(false) @map("is_hotspot")
  createdAt  DateTime @default(now()) @map("created_at")

  reports  Report[]
  missions Mission[]
  hotspots Hotspot[]

  @@map("locations")
}

// ── NGO ──────────────────────────────────────────────────────────────────────
model Ngo {
  ngoId          String   @id @default(cuid()) @map("ngo_id")
  name           String
  contactPerson  String?  @map("contact_person")
  email          String   @unique
  phone          String?
  expertiseAreas String[] @map("expertise_areas")
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")

  missions Mission[]
  fundings Funding[]
  memberships NgoMembership[]
  reportOffers NgoReportOffer[]
  costClaims NgoCostClaim[]

  @@map("ngos")
}

// ── Volunteer ────────────────────────────────────────────────────────────────
model Volunteer {
  volunteerId  String   @id @default(cuid()) @map("volunteer_id")
  name         String
  email        String   @unique
  phone        String?
  skills       String[]
  availability String?
  createdAt    DateTime @default(now()) @map("created_at")

  missionVolunteers MissionVolunteer[]

  @@map("volunteers")
}

// ── Mission ──────────────────────────────────────────────────────────────────
model Mission {
  missionId     String    @id @default(cuid()) @map("mission_id")
  locationId    String    @map("location_id")
  ngoId         String    @map("ngo_id")
  reportId      String?   @map("report_id")
  leadNgo       String    @map("lead_ngo")  // legacy text fallback
  missionType   String    @map("mission_type") // cleanup/awareness/etc.
  priority      String    // high/moderate/low
  status        String    // planned/in_progress/completed
  assignedTo    String    @map("assigned_to") // team/volunteer
  scheduledDate DateTime  @map("scheduled_date")
  estimatedCost Float?    @map("estimated_cost")
  actualCost    Float?    @map("actual_cost")
  totalSlots    Int       @default(20) @map("total_slots")
  filledSlots   Int       @default(0) @map("filled_slots")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [locationId])
  ngo      Ngo      @relation(fields: [ngoId], references: [ngoId])
  report   Report?  @relation(fields: [reportId], references: [reportId])

  missionVolunteers MissionVolunteer[]
  missionActivities MissionActivity[]
  evidences         Evidence[]
  fundings          Funding[]
  impactReports     ImpactReport[]
  statusEvents      MissionStatusEvent[]
  costClaims        NgoCostClaim[]
  csrGrants         CsrGrant[]

  @@map("missions")
}

// ── Mission_Volunteer ────────────────────────────────────────────────────────
model MissionVolunteer {
  missionVolunteerId String   @id @default(cuid()) @map("mission_volunteer_id")
  missionId          String   @map("mission_id")
  volunteerId        String   @map("volunteer_id")
  role               String
  status             String   @default("registered")
  hoursContributed   Float?   @map("hours_contributed")
  createdAt          DateTime @default(now()) @map("created_at")

  mission   Mission   @relation(fields: [missionId], references: [missionId])
  volunteer Volunteer @relation(fields: [volunteerId], references: [volunteerId])

  @@map("mission_volunteers")
  @@unique([missionId, volunteerId])
}

// ── Citizen_Confirmation ─────────────────────────────────────────────────────
model CitizenConfirmation {
  confirmationId String   @id @default(cuid()) @map("confirmation_id")
  reportId       String   @map("report_id")
  citizenId      String   @map("citizen_id")
  status         String   // clean/partial/unresolved
  photoUrl       String?  @map("photo_url")
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  report  Report  @relation(fields: [reportId], references: [reportId])
  citizen Citizen @relation(fields: [citizenId], references: [citizenId])

  @@map("citizen_confirmations")
}

// ── Hotspot ──────────────────────────────────────────────────────────────────
model Hotspot {
  hotspotId       String    @id @default(cuid()) @map("hotspot_id")
  locationId      String    @map("location_id")
  recurrenceCount Int       @default(0) @map("recurrence_count")
  lastCleanedDate DateTime? @map("last_cleaned_date")
  status          String    // active/resolved
  createdAt       DateTime  @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [locationId])

  rootCauses    RootCause[]
  interventions Intervention[]

  @@map("hotspots")
}

// ── Root_Cause ───────────────────────────────────────────────────────────────
model RootCause {
  rootCauseId             String   @id @default(cuid()) @map("root_cause_id")
  hotspotId               String   @map("hotspot_id")
  causeType               String   @map("cause_type") // dumping/drainage/etc.
  description             String
  recommendedIntervention String?  @map("recommended_intervention")
  createdAt               DateTime @default(now()) @map("created_at")

  hotspot Hotspot @relation(fields: [hotspotId], references: [hotspotId])

  @@map("root_causes")
}

// ── Intervention ─────────────────────────────────────────────────────────────
model Intervention {
  interventionId String   @id @default(cuid()) @map("intervention_id")
  hotspotId      String   @map("hotspot_id")
  type           String   // infrastructure/awareness/etc.
  description    String
  status         String   // planned/in_progress/completed
  createdAt      DateTime @default(now()) @map("created_at")

  hotspot Hotspot @relation(fields: [hotspotId], references: [hotspotId])

  @@map("interventions")
}

// ── Funding ──────────────────────────────────────────────────────────────────
model Funding {
  fundingId         String   @id @default(cuid()) @map("funding_id")
  missionId         String   @map("mission_id")
  ngoId             String   @map("ngo_id")
  amount            Float
  fundingSource     String   @map("funding_source") // CSR/donor/etc.
  receivedDate      DateTime @map("received_date")
  utilizationStatus String   @map("utilization_status")
  createdAt         DateTime @default(now()) @map("created_at")

  mission Mission @relation(fields: [missionId], references: [missionId])
  ngo     Ngo     @relation(fields: [ngoId], references: [ngoId])

  @@map("fundings")
}

// ── Impact_Report ────────────────────────────────────────────────────────────
model ImpactReport {
  impactId                  String   @id @default(cuid()) @map("impact_id")
  missionId                 String   @map("mission_id")
  totalCleanedLocations     Int      @map("total_cleaned_locations")
  totalWasteRemoved         Float    @map("total_waste_removed")
  volunteerHours            Float    @map("volunteer_hours")
  recurringHotspotsResolved Int      @map("recurring_hotspots_resolved")
  environmentalBenefits     String?  @map("environmental_benefits")
  status                    String
  createdAt                 DateTime @default(now()) @map("created_at")

  mission Mission @relation(fields: [missionId], references: [missionId])

  @@map("impact_reports")
}

// ── Evidence ─────────────────────────────────────────────────────────────────
model Evidence {
  evidenceId   String   @id @default(cuid()) @map("evidence_id")
  missionId    String   @map("mission_id")
  type         String   // before/after/video
  photoUrl     String   @map("photo_url")
  cloudinaryId String?  @map("cloudinary_id")
  description  String?
  timestamp    DateTime @default(now())
  locationLat  Float?   @map("location_lat")
  locationLong Float?   @map("location_long")
  verified     Boolean  @default(false)
  verifiedBy   String?  @map("verified_by")
  createdAt    DateTime @default(now()) @map("created_at")

  mission Mission @relation(fields: [missionId], references: [missionId])

  @@map("evidences")
}

// ── Mission_Activity ─────────────────────────────────────────────────────────
model MissionActivity {
  activityId   String    @id @default(cuid()) @map("activity_id")
  missionId    String    @map("mission_id")
  activityType String    @map("activity_type") // cleanup/awareness/etc.
  description  String
  startTime    DateTime? @map("start_time")
  endTime      DateTime? @map("end_time")
  status       String
  progressPercent Int?  @map("progress_percent")
  createdAt    DateTime  @default(now()) @map("created_at")

  mission Mission @relation(fields: [missionId], references: [missionId])

  @@map("mission_activities")
}

// NGO portal identity maps a Supabase Auth user to an approved NGO.
model NgoMembership {
  membershipId  String   @id @default(cuid()) @map("membership_id")
  supabaseUserId String   @map("supabase_user_id")
  ngoId         String   @map("ngo_id")
  role          String   @default("field_staff") // owner/manager/field_staff
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  ngo          Ngo                 @relation(fields: [ngoId], references: [ngoId])
  statusEvents MissionStatusEvent[]

  @@unique([supabaseUserId, ngoId])
  @@index([supabaseUserId, isActive])
  @@map("ngo_memberships")
}

model NgoReportOffer {
  offerId     String   @id @default(cuid()) @map("offer_id")
  reportId    String   @map("report_id")
  ngoId       String   @map("ngo_id")
  status      String   @default("offered") // offered/accepted/declined/closed
  offeredAt   DateTime @default(now()) @map("offered_at")
  respondedAt DateTime? @map("responded_at")

  report Report @relation(fields: [reportId], references: [reportId])
  ngo    Ngo    @relation(fields: [ngoId], references: [ngoId])

  @@unique([reportId, ngoId])
  @@index([ngoId, status, offeredAt])
  @@map("ngo_report_offers")
}

model MissionStatusEvent {
  eventId      String   @id @default(cuid()) @map("event_id")
  missionId    String   @map("mission_id")
  membershipId String?  @map("membership_id")
  fromStatus   String?  @map("from_status")
  toStatus     String   @map("to_status")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  mission    Mission        @relation(fields: [missionId], references: [missionId])
  membership NgoMembership? @relation(fields: [membershipId], references: [membershipId])

  @@index([missionId, createdAt])
  @@map("mission_status_events")
}

model NgoCostClaim {
  claimId    String   @id @default(cuid()) @map("claim_id")
  ngoId      String   @map("ngo_id")
  missionId  String   @map("mission_id")
  title      String
  notes      String?
  amount     Float
  status     String   @default("submitted") // submitted/under_review/approved/rejected/paid
  submittedAt DateTime @default(now()) @map("submitted_at")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  ngo     Ngo                @relation(fields: [ngoId], references: [ngoId])
  mission Mission            @relation(fields: [missionId], references: [missionId])
  items   NgoCostClaimItem[]

  @@index([ngoId, status, submittedAt])
  @@map("ngo_cost_claims")
}

model NgoCostClaimItem {
  itemId       String   @id @default(cuid()) @map("item_id")
  claimId      String   @map("claim_id")
  description  String
  amount       Float
  receiptUrl   String?  @map("receipt_url")
  cloudinaryId String?  @map("cloudinary_id")
  createdAt    DateTime @default(now()) @map("created_at")

  claim NgoCostClaim @relation(fields: [claimId], references: [claimId])

  @@map("ngo_cost_claim_items")
}

// Public partner applications are reviewed before portal access is created.
model NgoApplication {
  applicationId      String    @id @default(cuid()) @map("application_id")
  name               String
  contactPerson      String    @map("contact_person")
  email              String
  phone              String
  address            String
  registrationNumber String?   @map("registration_number")
  expertiseAreas     String[]  @map("expertise_areas")
  status             String    @default("pending") // pending/approved/rejected
  createdAt          DateTime  @default(now()) @map("created_at")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewedBy         String?   @map("reviewed_by")

  @@index([status, createdAt])
  @@index([email, status])
  @@map("ngo_applications")
}

model CsrApplication {
  applicationId      String    @id @default(cuid()) @map("application_id")
  organizationName   String    @map("organization_name")
  contactPerson      String    @map("contact_person")
  email              String
  phone              String
  registrationNumber String?   @map("registration_number")
  status             String    @default("pending") // pending/approved/rejected
  createdAt          DateTime  @default(now()) @map("created_at")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewedBy         String?   @map("reviewed_by")

  @@index([status, createdAt])
  @@index([email, status])
  @@map("csr_applications")
}

model CsrOrganization {
  csrOrganizationId String   @id @default(cuid()) @map("csr_organization_id")
  name              String
  contactPerson     String   @map("contact_person")
  email             String   @unique
  phone             String
  registrationNumber String? @map("registration_number")
  createdAt         DateTime @default(now()) @map("created_at")

  memberships CsrMembership[]
  grants      CsrGrant[]

  @@map("csr_organizations")
}

model CsrMembership {
  membershipId      String   @id @default(cuid()) @map("membership_id")
  supabaseUserId    String   @unique @map("supabase_user_id")
  csrOrganizationId String   @map("csr_organization_id")
  role              String   @default("owner")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  organization CsrOrganization @relation(fields: [csrOrganizationId], references: [csrOrganizationId])

  @@index([csrOrganizationId, isActive])
  @@map("csr_memberships")
}

// Records a CSR allocation commitment. It does not represent a payment.
model CsrGrant {
  grantId           String   @id @default(cuid()) @map("grant_id")
  csrOrganizationId String   @map("csr_organization_id")
  missionId         String   @map("mission_id")
  amount            Float
  status            String   @default("committed") // committed/released/cancelled
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization CsrOrganization @relation(fields: [csrOrganizationId], references: [csrOrganizationId])
  mission      Mission         @relation(fields: [missionId], references: [missionId])

  @@index([csrOrganizationId, status, createdAt])
  @@index([missionId])
  @@unique([csrOrganizationId, missionId])
  @@map("csr_grants")
}
